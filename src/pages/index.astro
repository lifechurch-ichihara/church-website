---
import Layout from '../layouts/Layout.astro';

const news = [
  { date: '2026.09.10', title: '秋の家族礼拝のお知らせ', href: '/news' },
  { date: '2026.09.03', title: '子ども祝福式を行いました', href: '/news' },
  { date: '2026.08.20', title: '夏期特別集会レポート', href: '/news' },
];
---

<Layout title="トップ">
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <h1>あなたを、心から歓迎します</h1>
      <p>ライフチャーチ市原は、誰もが安心して集える教会です。</p>
      <a href="/service" class="btn">礼拝案内を見る</a>
    </div>
  </section>

  <section class="section service-summary">
    <div class="container">
      <h2>礼拝のご案内</h2>
      <div class="summary-grid">
        <div class="summary-card">
          <p class="summary-label">日時</p>
          <p class="summary-value">毎週日曜日 10:30〜</p>
        </div>
        <div class="summary-card">
          <p class="summary-label">場所</p>
          <p class="summary-value">千葉県市原市〇〇1-2-3</p>
        </div>
      </div>
      <a href="/service">詳しい礼拝案内はこちら</a>
    </div>
  </section>

  <section class="section pastor-message">
    <div class="container message-grid">
      <div>
        <h2>牧師からのメッセージ</h2>
        <p>
          はじめまして。ライフチャーチ市原の牧師です。
          ここに、教会の歩みや大切にしていることについての
          メッセージを入れます。
        </p>
      </div>
    </div>
  </section>

  <section class="section first-visit">
    <div class="container">
      <h2>はじめての方へ</h2>
      <p>
        服装は自由です。お子様連れも大歓迎です。
        礼拝の流れや持ち物について、事前に知っておきたい方はこちらをご覧ください。
      </p>
      <a href="/about" class="btn btn-outline">教会について詳しく見る</a>
    </div>
  </section>

  <section class="section news-preview">
    <div class="container">
      <h2>お知らせ</h2>
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <span class="news-date">{item.date}</span>
            <a href={item.href}>{item.title}</a>
          </li>
        ))}
      </ul>
      <a href="/news">お知らせ一覧を見る</a>
    </div>
  </section>

  <section class="section access-preview">
    <div class="container">
      <h2>アクセス</h2>
      <p>千葉県市原市〇〇1-2-3(最寄駅から徒歩10分・駐車場あり)</p>
      <a href="/access">地図・詳しいアクセスはこちら</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: url('/images/hero.jpg') center/cover no-repeat, var(--color-teal);
    color: #fff;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(43,107,118,0.35), rgba(43,107,118,0.6));
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding: 80px 24px;
  }

  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    max-width: 14ch;
    margin-bottom: 0.4em;
  }

  .hero p {
    font-size: 1.1rem;
    max-width: 40ch;
  }

  .btn {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text);
    font-weight: 600;
    padding: 12px 28px;
    border-radius: 999px;
    margin-top: 8px;
  }

  .btn:hover { background: var(--color-accent-dark); color: #fff; }

  .btn-outline {
    background: transparent;
    border: 2px solid var(--color-teal);
    color: var(--color-teal);
  }

  .btn-outline:hover {
    background: var(--color-teal);
    color: #fff;
  }

  .section {
    padding: 56px 0;
  }

  .section:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .summary-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 24px 0;
  }

  .summary-card {
    background: #fff;
    border-left: 4px solid var(--color-accent);
    padding: 16px 24px;
    min-width: 220px;
  }

  .summary-label {
    font-size: 0.85rem;
    color: var(--color-teal-dark);
    margin: 0 0 4px;
  }

  .summary-value {
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0;
  }

  .message-grid {
    max-width: 60ch;
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }

  .news-list li {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-bg-alt);
  }

  .news-date {
    color: var(--color-teal-dark);
    font-size: 0.9rem;
    white-space: nowrap;
  }
</style>