---
import Layout from '../layouts/Layout.astro';

const news = [
  { date: '10.09.2026', title: 'Culto especial de família no outono', href: '/news' },
  { date: '03.09.2026', title: 'Realizamos a cerimônia de bênção das crianças', href: '/news' },
  { date: '20.08.2026', title: 'Relatório do encontro especial de verão', href: '/news' },
];
---

<Layout title="Início">
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <h1>Você é bem-vindo aqui</h1>
      <p>A Life Church Ichihara é uma igreja onde todos podem se sentir em casa.</p>
      <a href="/service" class="btn">Ver horários dos cultos</a>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <h2>Horário do Culto</h2>
      <div class="summary-grid">
        <div class="summary-card">
          <p class="summary-label">Data e hora</p>
          <p class="summary-value">Todo domingo às 10h30</p>
        </div>
        <div class="summary-card">
          <p class="summary-label">Endereço</p>
          <p class="summary-value">Chiba-ken, Ichihara-shi, 〇〇1-2-3</p>
        </div>
      </div>
      <a href="/service">Ver detalhes dos cultos</a>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container message-grid">
      <h2>Mensagem do Pastor</h2>
      <p>
        Seja bem-vindo! Aqui vamos compartilhar a caminhada da nossa igreja
        e aquilo que consideramos mais importante para nossa família de fé.
      </p>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <h2>Primeira Visita</h2>
      <p>
        Não é necessário se vestir formalmente. Crianças são muito bem-vindas.
        Saiba mais sobre como funciona o culto antes de visitar.
      </p>
      <a href="/about" class="btn btn-outline">Saiba mais sobre a igreja</a>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <h2>Notícias</h2>
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <span class="news-date">{item.date}</span>
            <a href={item.href}>{item.title}</a>
          </li>
        ))}
      </ul>
      <a href="/news">Ver todas as notícias</a>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <h2>Como Chegar</h2>
      <p>Chiba-ken, Ichihara-shi, 〇〇1-2-3 (10 min a pé da estação mais próxima, estacionamento disponível)</p>
      <a href="/access">Ver mapa e detalhes</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: url('/images/hero.jpg') center/cover no-repeat, var(--color-dark);
    color: var(--color-text-on-dark);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(42,42,46,0.4), rgba(42,42,46,0.7));
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding: 80px 24px;
  }

  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    max-width: 16ch;
    margin-bottom: 0.4em;
    color: var(--color-accent);
  }

  .hero p {
    font-size: 1.1rem;
    max-width: 40ch;
  }

  .btn {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-dark);
    font-weight: 600;
    padding: 12px 28px;
    border-radius: 999px;
    margin-top: 8px;
  }

  .btn:hover { background: var(--color-accent-dark); color: #fff; }

  .btn-outline {
    background: transparent;
    border: 2px solid var(--color-accent-dark);
    color: var(--color-accent-dark);
  }

  .btn-outline:hover {
    background: var(--color-accent-dark);
    color: #fff;
  }

  .section {
    padding: 56px 0;
  }

  .section-light {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .section-dark {
    background: var(--color-dark-alt);
    color: var(--color-text-on-dark);
  }

  .section-dark h2 {
    color: var(--color-accent);
  }

  .section-dark a {
    color: var(--color-accent);
  }

  .summary-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 24px 0;
  }

  .summary-card {
    background: #fff;
    border-left: 4px solid var(--color-accent);
    padding: 16px 24px;
    min-width: 220px;
  }

  .summary-label {
    font-size: 0.85rem;
    color: var(--color-accent-dark);
    margin: 0 0 4px;
  }

  .summary-value {
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0;
    color: var(--color-text);
  }

  .message-grid {
    max-width: 60ch;
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }

  .news-list li {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(234,230,220,0.15);
  }

  .news-date {
    color: var(--color-accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }
</style>