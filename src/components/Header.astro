---
import { withBase } from '../utils/url';

const navItems = [
  { label: 'Início', href: '/church-website' },
  { label: 'Sobre', href: '/about' },
  { label: 'Cultos', href: '/service' },
  { label: 'Notícias', href: '/news' },
  { label: 'Mensagens', href: '/sermons' },
  { label: 'Galeria', href: '/gallery' },
  { label: 'local', href: '/access' },
  { label: 'Contato', href: '/contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">Life Church Ichihara</a>

    <button id="nav-toggle" class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav">
      <ul>
        {navItems.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>

<style>
  .site-header {
    background: var(--color-dark);
    border-bottom: 3px solid var(--color-accent);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: var(--color-text-on-dark);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-nav a:hover { color: var(--color-accent); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .nav-toggle span {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  @media (max-width: 860px) {
    .nav-toggle { display: flex; }

    .site-nav {
      display: none;
      width: 100%;
      order: 3;
      margin-top: 16px;
    }

    .site-nav.is-open { display: block; }

    .site-nav ul {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>