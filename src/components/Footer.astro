---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-name">Life Church Ichihara</p>
    <p class="footer-copy">&copy; {year} Life Church Ichihara</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: var(--color-text-on-dark);
    margin-top: 64px;
  }

  .footer-inner {
    padding: 32px 24px;
    text-align: center;
  }

  .footer-name {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 4px;
  }

  .footer-copy {
    font-size: 0.85rem;
    opacity: 0.8;
    margin: 0;
  }
</style>